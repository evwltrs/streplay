<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <AssemblyName>streplay</AssemblyName>
    <RootNamespace>Streplay</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep in sync with Plugin.Version and thunderstore/manifest.json (the Pack target checks) -->
    <Version>1.1.5</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Where the game lives: Steam's default library unless set in local.props (git-ignored, see local.props.example)
         or with dotnet build -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\STRAFTAT</GameDir>
    <ManagedDir>$(GameDir)\STRAFTAT_Data\Managed</ManagedDir>
    <!-- r2modman profile to deploy into for testing. Its own profile so it never runs next to a dev build. -->
    <R2Profile Condition="'$(R2Profile)' == ''">StreplayPublic</R2Profile>
    <PluginsDir Condition="'$(PluginsDir)' == ''">$(APPDATA)\r2modmanPlus-local\STRAFTAT\profiles\$(R2Profile)\BepInEx\plugins</PluginsDir>
  </PropertyGroup>

  <!-- The autotest harness is for development only: compiled into Debug builds, never into the release package. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);STREPLAY_AUTOTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="src/AutoTest.cs" />
  </ItemGroup>

  <!-- the STREPLAY_FFMPEG package's StreplayFfmpeg.dll: its own project, linked against but never shipped here -->
  <ItemGroup>
    <Compile Remove="ffmpeg-package/**" />
    <ProjectReference Include="ffmpeg-package\bridge\StreplayFfmpeg.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)\ComputerysModdingUtilities.dll" Private="false" />
    <Reference Include="$(ManagedDir)\FishNet.Runtime.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(ManagedDir)\ICSharpCode.SharpZipLib.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)\DOTween.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.Postprocessing.Runtime.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToR2" AfterTargets="Build" Condition="Exists('$(PluginsDir)\..')">
    <MakeDir Directories="$(PluginsDir)\streplay" />
    <!-- fails while the game is running (it locks the DLL); close the game and build again -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)\streplay" Retries="0" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="_Deployed" />
    </Copy>
    <Message Importance="high" Condition="'@(_Deployed)' != ''" Text="STREPLAY deployed to $(PluginsDir)\streplay" />
    <Message Importance="high" Condition="'@(_Deployed)' == ''" Text="STREPLAY NOT deployed (close the game and build again)" />
  </Target>

  <!-- dotnet build -c Release -t:ThunderstorePack  ->  dist\1nf-STREPLAY-<version>.zip, ready to upload to Thunderstore -->
  <Target Name="ThunderstorePack" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Pack a Release build: dotnet build -c Release -t:ThunderstorePack" />
    <PropertyGroup>
      <_Manifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\thunderstore\manifest.json'))</_Manifest>
      <_PluginCs>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\src\Plugin.cs'))</_PluginCs>
    </PropertyGroup>
    <Error Condition="!$(_Manifest.Contains('&quot;version_number&quot;: &quot;$(Version)&quot;'))"
           Text="thunderstore\manifest.json version_number does not match $(Version)" />
    <Error Condition="!$(_PluginCs.Contains('Version = &quot;$(Version)&quot;'))"
           Text="src\Plugin.cs Version does not match $(Version)" />
    <PropertyGroup>
      <_Stage>$(MSBuildProjectDirectory)\obj\thunderstore</_Stage>
      <_Zip>$(MSBuildProjectDirectory)\dist\1nf-STREPLAY-$(Version).zip</_Zip>
    </PropertyGroup>
    <RemoveDir Directories="$(_Stage)" />
    <Copy SourceFiles="thunderstore\manifest.json;thunderstore\icon.png;README.md;CHANGELOG.md" DestinationFolder="$(_Stage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_Stage)\BepInEx\plugins\streplay" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist" />
    <Delete Files="$(_Zip)" />
    <ZipDirectory SourceDirectory="$(_Stage)" DestinationFile="$(_Zip)" />
    <Message Importance="high" Text="Thunderstore package: $(_Zip)" />
  </Target>

</Project>

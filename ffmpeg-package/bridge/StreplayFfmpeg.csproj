<Project Sdk="Microsoft.NET.Sdk">

  <!-- The part of STREPLAY that starts a program: ffmpeg, for renders. It ships in the
       STREPLAY_FFMPEG package next to ffmpeg.exe, so the main STREPLAY package starts no processes of its own.
       Plain .NET, no game or Unity references: STREPLAY links against it and only touches it when it's installed. -->
  <PropertyGroup>
    <AssemblyName>StreplayFfmpeg</AssemblyName>
    <RootNamespace>StreplayFfmpeg</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Bump only when the API below changes; STREPLAY checks it (Bridge.Version) -->
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>
